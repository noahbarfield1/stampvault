# ──────────────────────────────────────────────────────────────────────────────
# StampVault environment
#
# Copy to .env.local and fill in. Only ONE value is strictly required to run the
# app with live pricing; the rest are optional or production-only.
#
# NOTE: .gitignore's `.env*` rule would normally hide this file too — it stays
# tracked via an explicit `!.env.local.example` negation. Keep that, or a fresh
# clone has no way to know what to configure.
# ──────────────────────────────────────────────────────────────────────────────

# ── Vertex AI (Gemini) — powers identification, segmentation and chat ────────
#
# There is NO API key for this. /api/chat, /api/stamps/identify and
# /api/stamps/segment run in Vertex AI mode against the project pinned in
# src/lib/ai/vertex.ts and authenticate through Application Default Credentials.
#
#   Local:     run `gcloud auth application-default login` once, then leave the
#              variable below empty — the SDK finds ADC on its own.
#   Deployed:  set this to the entire JSON of a service-account key holding the
#              "Vertex AI User" role, on a single line.
#
# GOOGLE_API_KEY / GEMINI_API_KEY are no longer used: API-key auth is rejected
# for the model ids this app needs.
GOOGLE_VERTEX_CREDENTIALS_JSON=

# ── Firecrawl — REQUIRED for live pricing ────────────────────────────────────
#
# FALLBACK only — used when the eBay keys below are unset. Scrapes ACTIVE eBay
# listings (sold listings sit behind a sign-in wall, so they are not attempted).
# Costs one credit per lookup. Without it, price lookups fall through to the
# "no data" tier and say so, rather than inventing a number.
# Get a key at https://firecrawl.dev
FIRECRAWL_API_KEY=your-firecrawl-key

# ── eBay Browse API — PREFERRED pricing source ───────────────────────────────
#
# Free (~5,000 calls/day), returns structured JSON, and is not bot-blocked.
# When both values below are set, pricing uses eBay automatically and spends no
# Firecrawl credits at all.
#
# Get them at https://developer.ebay.com/my/keys — create an application, then
# copy the PRODUCTION keyset (not Sandbox):
#   EBAY_CLIENT_ID      = App ID  (Client ID)
#   EBAY_CLIENT_SECRET  = Cert ID (Client Secret)
#
# Note: Browse returns CURRENTLY LISTED items, i.e. asking prices. Completed
# sale prices need the Marketplace Insights API, which is a restricted release
# requiring separate approval from eBay.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# ── Pricing provider (optional override) ─────────────────────────────────────
# Leave unset: eBay is chosen automatically when its keys are present, and
# Firecrawl otherwise. Set to `ebay` or `firecrawl` only to pin one explicitly.
# PRICING_PROVIDER=ebay

# ── Firebase (optional — only once cloud sync is enabled) ────────────────────
# Client SDK config for cross-device collection sync. Until sync is switched on
# the collection lives in the browser only and these can stay empty.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
